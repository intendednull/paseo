#!/usr/bin/env bash
# .fork/gate — the parts of upstream's ci.yml this fork's queue can affect.
# Run from the clone root after `npm ci --ignore-scripts` and
# `node scripts/postinstall-patches.mjs` (with node_modules/.bin on PATH).
# ~/.npmrc sets ignore-scripts, which also skips pre* run-scripts (the protocol
# package generates its validators in prebuild), so they are re-enabled here.
set -euo pipefail
cd "$(dirname "$0")/.."
# The fork's own flake supplies nodejs_22, so the gate runs the same on every machine.
exec nix develop "$PWD" -c bash -euo pipefail -c '
export PATH=$PWD/node_modules/.bin:$PATH npm_config_ignore_scripts=false
base=$(cat .fork/base)
git merge-base --is-ancestor "$base" HEAD || { echo "gate: HEAD is not on $base (.fork/base)" >&2; exit 1; }
oxfmt --check $(git diff --name-only --diff-filter=d "$base" HEAD -- . ":!.fork/notes")
oxlint
npm run build:server
npm run typecheck --workspace=@getpaseo/server --workspace=@getpaseo/client --workspace=@getpaseo/app --workspace=@getpaseo/desktop
(cd packages/server && npx vitest run \
  src/server/speech/providers/openai src/server/session/voice \
  src/server/agent/tts-manager.test.ts \
  src/server/agent/agent-compact.test.ts src/server/agent/idle-compaction \
  src/server/agent/agent-messages src/server/agent/mcp-server.test.ts \
  src/server/agent/agent-run-state.test.ts \
  src/server/agent/provider-registry-wrap.test.ts \
  src/server/agent/providers/acp-agent.test.ts \
  src/server/agent/providers/claude/mcp-config-file.test.ts \
  src/server/agent/providers/claude/agent.spawn.test.ts \
  src/server/agent/providers/codex-app-server-agent.test.ts \
  src/server/agent/providers/opencode/v2/agent.test.ts \
  src/server/agent/providers/opencode/v2/timeline.test.ts \
  src/server/connected-hosts/wake.e2e.test.ts src/server/agent/host-operations \
  src/server/config.test.ts src/server/persisted-config-json-schema.test.ts)
(cd packages/client && npx vitest run \
  src/daemon-client.test.ts -t "streamFile|readFile")
(cd packages/app && npx vitest run --project unit \
  src/utils/workspace-agent-activity.test.ts src/plugins/client-state/snapshots.test.ts \
  src/components/sidebar src/components/sidebar-workspace-list.test.tsx \
  src/stores/sidebar-view-store.test.ts src/stores/download-store.test.ts src/i18n \
  src/runtime/host-runtime.test.ts src/audio/audio-engine.web.test.ts)
npm run test --workspace=@getpaseo/desktop
'
