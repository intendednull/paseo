#!/usr/bin/env bash
# .fork/gate — the parts of upstream's ci.yml this fork's queue can affect.
# Run from the clone root after `npm ci --ignore-scripts` and
# `node scripts/postinstall-patches.mjs` (with node_modules/.bin on PATH).
# ~/.npmrc sets ignore-scripts, which also skips pre* run-scripts (the protocol
# package generates its validators in prebuild), so they are re-enabled here.
set -euo pipefail
cd "$(dirname "$0")/.."
exec nix shell --inputs-from ~/nixos nixpkgs#nodejs_22 -c bash -euo pipefail -c '
export PATH=$PWD/node_modules/.bin:$PATH npm_config_ignore_scripts=false
base=$(cat .fork/base)
git merge-base --is-ancestor "$base" HEAD || { echo "gate: HEAD is not on $base (.fork/base)" >&2; exit 1; }
oxfmt --check $(git diff --name-only --diff-filter=d "$base" HEAD -- . ":!.fork/notes")
oxlint
npm run build:server
npm run typecheck --workspace=@getpaseo/server --workspace=@getpaseo/app --workspace=@getpaseo/desktop
(cd packages/server && npx vitest run \
  src/server/speech/providers/openai src/server/session/voice \
  src/server/agent/agent-compact.test.ts src/server/agent/idle-compaction \
  src/server/agent/provider-registry-wrap.test.ts)
(cd packages/app && npx vitest run --project unit \
  src/utils/workspace-agent-activity.test.ts src/plugins/client-state/snapshots.test.ts \
  src/components/sidebar src/components/sidebar-workspace-list.test.tsx \
  src/stores/sidebar-view-store.test.ts src/i18n)
npm run test --workspace=@getpaseo/desktop
'
